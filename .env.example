# Copy to .env and fill in. .env is gitignored.
# Discord application credentials — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APP_ID=

# Guilds to register slash commands to (comma-separated). Per-guild registration
# is instant; global registration is intentionally not supported. List every
# server the bot runs in, e.g. test,prod.
DISCORD_GUILD_IDS=

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Optional: channel id to post interaction audit embeds to (who invoked what,
# when, with which args / panel clicks). Leave blank to disable audit logging.
AUDIT_LOG_CHANNEL_ID=

# Optional: role IDs (comma-separated) allowed to run admin/dev commands.
# Members with the Manage Server permission always qualify. When blank, access
# falls back to the legacy role *named* "dev" (weaker — set real IDs in prod).
DISCORD_ADMIN_ROLE_IDS=
