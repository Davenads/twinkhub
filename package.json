{
  "name": "twinkhub",
  "version": "0.0.0",
  "private": true,
  "description": "Generalized data + timer Discord bot for the WoW Classic Era twinking community (starting with the 10-19 WSG bracket). discord.js.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js",
    "emojis:list": "node scripts/list-emojis.js",
    "test": "node --test",
    "test:int": "node -r dotenv/config --test --test-concurrency=1 test/integration/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "luxon": "^3.5.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0"
  }
}
